<app-shell class="index-shell">
  <app-header title="{param.title|INDEX DATABASE}" subtitle="{param.subtitle|Items, recipes, usages, machines, and discoveries.}"/>
  <grid class="index-shell-grid" columns="{param.columns|144px 1fr 144px}" gap="10" stack-below="sm">
    <app-sidebar title="Index">
      <nav-list>
        <nav-item action="index.open_page" action-page="echoindex:index_dashboard"><title value="Dashboard"/></nav-item>
        <nav-item action="index.open_page" action-page="echoindex:index_items"><title value="Item Browser"/></nav-item>
        <nav-item action="index.open_page" action-page="echoindex:index_recipes"><title value="Recipe Browser"/></nav-item>
        <nav-item action="index.open_page" action-page="echoindex:index_usages"><title value="Usage Browser"/></nav-item>
        <nav-item action="index.open_page" action-page="echoindex:index_machines"><title value="Machine Browser"/></nav-item>
      </nav-list>
    </app-sidebar>
    <app-content title="{param.contentTitle|Workspace}">
      <slot-outlet name="content"/>
    </app-content>
    <inspector-panel title="{param.inspectorTitle|Inspector}">
      <slot-outlet name="inspector"/>
    </inspector-panel>
  </grid>
</app-shell>
