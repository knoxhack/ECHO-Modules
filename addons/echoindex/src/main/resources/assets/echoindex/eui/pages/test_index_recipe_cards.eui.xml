<page id="test_index_recipe_cards" title="Test Index Recipe Cards" styles="index_cyberglass,index_components,index_recipes">
  <screen-shell><header title="Index Recipe Cards" subtitle="Recipe provider cards, detail preview, and empty-state polish"/><component src="echoindex:index_recipe_flow"><slot name="inputs"><list-row class="index-recipe-slot-card"><row gap="8"><item-stack item="minecraft:iron_ingot" count="2" tooltip="Iron Ingot"/><column><label value="Input"/><text class="index-recipe-slot-label" value="Iron Ingot"/></column></row></list-row></slot><slot name="outputs"><list-row class="index-recipe-slot-card"><row gap="8"><item-stack item="minecraft:stick" count="1" tooltip="Stick"/><column><label value="Output"/><text class="index-recipe-slot-label" value="Stick"/></column></row></list-row></slot></component><list bind="index.recipes.visible" item="recipe" selected="{index.recipe.selected.id}"><component src="echoindex:index_recipe_card" value="{recipe.id}"><param name="id" value="{recipe.id}"/><param name="icon" value="{recipe.icon}"/><param name="title" value="{recipe.title}"/><param name="summary" value="{recipe.inputSummary} &gt; {recipe.outputSummary}"/><param name="meta" value="{recipe.typeName}"/></component><empty-state title="No recipe cards" body="Provider returned no recipe cards for this test page."/></list></screen-shell>
</page>
