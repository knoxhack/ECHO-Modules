<page id="index_dashboard" title="ECHO Index Dashboard" styles="index_cyberglass,index_components">
  <component src="echoindex:index_shell">
    <param name="contentTitle" value="Overview"/>
    <param name="inspectorTitle" value="Status"/>
    <slot name="content">
      <panel title="Fast Routes">
        <text class="index-dashboard-hint" value="Browse Ashfall records without leaving the terminal shell."/>
        <column class="index-dashboard-actions" gap="8">
          <button action="index.open_page" action-page="echoindex:index_items" tooltip="Browse items grouped by mod and category.">Items: {index.dashboard.visibleItemCount} visible</button>
          <button action="index.open_page" action-page="echoindex:index_recipes" tooltip="Browse recipes, machine processes, and provider source cards.">Recipes: {index.dashboard.visibleRecipeCount} visible</button>
          <button action="index.open_page" action-page="echoindex:index_machines" tooltip="Browse workstations and process providers.">Machines: {index.dashboard.visibleMachineCount} visible</button>
        </column>
      </panel>
    </slot>
    <slot name="inspector">
      <text class="index-dashboard-hint" value="{index.dashboard.itemCount} item(s) indexed"/>
      <text class="index-dashboard-hint" value="{index.dashboard.recipeCount} recipe(s) indexed"/>
      <text class="index-dashboard-hint" value="{index.dashboard.machineCount} machine(s) indexed"/>
      <text class="index-dashboard-hint" value="{index.dashboard.providerStatus}"/>
      <text class="index-dashboard-hint" value="{index.dashboard.providerHealthHint}"/>
    </slot>
  </component>
</page>
