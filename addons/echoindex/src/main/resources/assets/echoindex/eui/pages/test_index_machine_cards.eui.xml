<page id="test_index_machine_cards" title="Test Index Machine Cards" styles="index_cyberglass,index_components,index_machines">
  <screen-shell><header title="Index Machine Cards" subtitle="Machine provider cards with focus and open-detail actions"/><list bind="index.machines.visible" item="machine" selected="{index.machine.selected.id}"><component src="echoindex:index_machine_card" value="{machine.id}"><param name="id" value="{machine.id}"/><param name="icon" value="{machine.icon}"/><param name="title" value="{machine.name}"/><param name="summary" value="{machine.recipeTypeSummary}"/><param name="meta" value="{machine.recipeCount} recipe(s)"/></component><empty-state title="No machine cards" body="Provider returned no machine cards for this debug page."/></list></screen-shell>
</page>
