{
  "schema_version": 12,
  "base_texture": "minecraft:textures/item/book.png",
  "default_state": "ACTIVE",
  "effect": {
    "preset": "terminal_hud",
    "glow_intensity": 0.34,
    "pulse_speed": 0.12,
    "bloom_tint": "#FFFFD166",
    "target_scope": "profile"
  },
  "anchors": {
    "screen": {
      "offset": [
        0,
        0,
        0
      ]
    }
  },
  "surface": {
    "type": "hud_overlay",
    "owner_addon": "echoindex",
    "display_name": "Screen Index Overlay",
    "tags": [
      "hud_overlay"
    ],
    "integration_mode": "optional"
  },
  "fallback": {
    "mode": "minimal_screen",
    "expectation": "stable RenderCore fallback remains readable",
    "allow_advanced_fx_fallback": true,
    "allow_missing_assets": false
  },
  "budget": {
    "tier": "normal",
    "advanced_fx": "auto"
  },
  "screen_chrome": {
    "style": "cyberglass",
    "label": "",
    "backdrop": false,
    "edge_glow": false,
    "corner_brackets": true,
    "accent_rails": true,
    "scanlines": false,
    "glass_glints": false,
    "chromatic_edge": false,
    "quiet_fallback": true
  },
  "qa": {
    "required": true,
    "evidence": [
      "screenshot",
      "screen_chrome"
    ],
    "reduced_motion": false
  }
}
