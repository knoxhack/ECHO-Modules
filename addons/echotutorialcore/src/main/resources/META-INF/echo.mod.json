  "permissions": [
    "player.data",
    "resources.data",
    "ui.screens"
  ],
  "assets": [
    "metadata/assets/modules/echotutorialcore/icon.png",
    "metadata/assets/modules/echotutorialcore/banner.png",
    "metadata/assets/modules/echotutorialcore/module_card.png",
    "metadata/assets/modules/echotutorialcore/showcase.png"
  ],
  "transforms": [],
  "access": {
    "adapterCore": {
      "domains": [
        "missions",
        "ui_screens",
        "wiki"
      ],
      "runtimes": [
        "neoforge",
        "echo_native",
        "echo_runtime_standalone"
      ]
    },
    "notes": "Tutorial card, hint, flow, tooltip, onboarding, and replay contract layer with optional first-party integrations.",
    "nativeEntrypoint": "com.knoxhack.echotutorialcore.EchoTutorialCoreNativeModule",
    "nativeClasspath": []
  },
  "apiStability": "beta",
  "ai": {
    "safeEditZones": [
      "src/main/java/com/knoxhack/echotutorialcore/**",
      "src/main/resources/**",
      "README.md",
      "SMOKE_TEST.md"
    ],
    "protectedFiles": [
      "build.gradle",
      "gradle.properties"
    ]
  },
  "deprecatedFeatures": [],
  "replacements": [],
  "conflicts": []
}
