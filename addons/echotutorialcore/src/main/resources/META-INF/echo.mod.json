{
  "schema": "echo.mod.v1",
  "id": "echotutorialcore",
  "name": "ECHO: TutorialCore",
  "version": "1.0.0",
  "type": "addon",
  "kind": "library",
  "role": "tutorial_core",
  "entrypoint": "com.knoxhack.echotutorialcore.EchoTutorialCore",
  "publisher": "Knoxhack",
  "channel": "beta",
  "official": true,
  "trustLevel": "official",
  "standalone": true,
  "clientOnly": false,
  "serverOnly": false,
  "side": "common",
  "requires": [
    "echoadaptercore",
    "echocore",
    "echonetcore"
  ],
  "optional": [
    "echodatacore",
    "echoholomap",
    "echoindex",
    "echolens",
    "echomissioncore",
    "echopowergrid",
    "echosoundcore",
    "echoterminal",
    "echothemecore",
    "echoworldcore"
  ],
  "provides": [
    "tutorial.cards",
    "tutorial.flows",
    "tutorial.hints",
    "tutorial.onboarding",
    "tutorial.tooltips"
  ],
  "consumes": [
    "echo.core",
    "echo.net"
