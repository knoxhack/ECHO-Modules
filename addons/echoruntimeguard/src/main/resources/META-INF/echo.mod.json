{
  "schema": "echo.mod.v1",
  "id": "echoruntimeguard",
  "name": "ECHO RuntimeGuard",
  "version": "1.0.0",
  "type": "addon",
  "kind": "library",
  "role": "foundation",
  "entrypoint": "com.knoxhack.echoruntimeguard.EchoRuntimeGuard",
  "publisher": "Knoxhack",
  "channel": "stable",
  "official": true,
  "trustLevel": "official",
  "standalone": true,
  "clientOnly": false,
  "serverOnly": false,
  "side": "common",
  "requires": [
    "echoadaptercore",
    "echocore",
    "echonetcore"
  ],
  "optional": [
    "echodatacore",
    "echoholomap",
    "echolens",
    "echomultiblockcore",
    "echoterminal",
    "echothemecore"
  ],
  "provides": [
    "runtime.budgets",
    "runtime.diagnostics",
    "runtime.health",
    "runtime.network_budget",
    "runtime.particle_budget",
    "runtime.performance_profiles",
    "runtime.smart_ticks"
  ],
  "consumes": [
    "echo.core",
    "echo.net"
  ],
  "gameModes": [
    "all"
  ],
  "permissions": [
    "diagnostics.read",
    "network.payloads",
    "server.commands",
    "runtime.metrics"
  ],
  "assets": [],
  "transforms": [],
  "access": {
    "adapterCore": {
      "domains": [
        "commands",
        "data",
        "diagnostics",
        "networking"
      ],
      "runtimes": [
        "neoforge",
        "echo_native",
        "echo_runtime_standalone"
      ]
    },
    "nativeEntrypoint": "com.knoxhack.echoruntimeguard.EchoRuntimeGuardNativeModule",
    "nativeClasspath": [],
    "notes": "Shared runtime performance, budget, diagnostics, smart ticking, particle, network, and pressure guard layer. Optional integrations must remain guarded and non-destructive."
  },
  "apiStability": "stable",
  "ai": {
    "safeEditZones": [
      "src/main/java/com/knoxhack/echoruntimeguard/**",
      "src/main/resources/**",
      "docs/**"
    ],
    "protectedFiles": [
      "build.gradle",
      "gradle.properties",
      "README.md",
      "SMOKE_TEST.md"
    ]
  },
  "deprecatedFeatures": [],
  "replacements": [],
  "conflicts": []
}
