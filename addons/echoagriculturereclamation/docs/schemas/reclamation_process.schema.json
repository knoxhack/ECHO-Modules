{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/echoagriculturereclamation/reclamation_process.schema.json",
  "title": "Agriculture Reclamation Process Definitions",
  "type": "object",
  "oneOf": [
    { "required": ["machine", "title"] },
    { "required": ["processes"] }
  ],
  "properties": {
    "processes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/process" }
    },
    "id": { "type": "string" },
    "machine": { "type": "string" },
    "title": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "catalysts": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "ticks": { "type": "integer", "minimum": 0 },
    "powerCost": { "type": "integer", "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "process": {
      "type": "object",
      "required": ["machine", "title"],
      "properties": {
        "machine": { "type": "string" },
        "title": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "catalysts": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "ticks": { "type": "integer", "minimum": 0 },
        "powerCost": { "type": "integer", "minimum": 0 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
