{
  "schema_version": 12,
  "surface": {
    "type": "static_block",
    "owner_addon": "echorendercore",
    "display_name": "V12 Certified Pack Core",
    "tags": ["static_block", "certified"],
    "integration_mode": "optional"
  },
  "fallback": {
    "mode": "stable",
    "expectation": "Stable emissive block visuals remain readable without advanced FX.",
    "allow_advanced_fx_fallback": true,
    "allow_missing_assets": false
  },
  "budget": {
    "tier": "normal",
    "advanced_fx": "auto"
  },
  "screen_chrome": {
    "style": "minimal",
    "label": "",
    "backdrop": false,
    "edge_glow": false,
    "corner_brackets": false,
    "accent_rails": false,
    "scanlines": false,
    "glass_glints": false,
    "chromatic_edge": false,
    "quiet_fallback": true
  },
  "qa": {
    "required": true,
    "evidence": ["screenshot", "world_surface"],
    "reduced_motion": false
  },
  "base_texture": "examplemod:textures/block/v12_certified_core.png",
  "default_state": "ACTIVE",
  "effect": {
    "preset": "neon",
    "glow_intensity": 1.1,
    "bloom_intensity": 0.35,
    "advanced_enabled": false,
    "bloom_channel": "certified_default"
