  "materials": {
    "certified_cyan": {
      "color": "#FF36E8FF",
      "alpha": 0.9,
      "emissive": true,
      "blend_mode": "additive",
      "light_mode": "fullbright",
      "render_pass": "emissive",
      "effect": {
        "preset": "hologram",
        "glow_intensity": 0.9,
        "scanline_strength": 0.0
      }
    }
  },
  "layers": [
    {
      "id": "certified_status_band",
      "kind": "glow",
      "texture": "examplemod:textures/block/v12_certified_status.png",
      "material": "certified_cyan",
      "states": ["ACTIVE", "ONLINE"]
    }
  ],
  "anchors": {
    "core": { "offset": [0.5, 0.5, 0.5] }
  }
}
