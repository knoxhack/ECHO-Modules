{
  "schema": "echo.mod.v1",
  "id": "echometadatacore",
  "name": "ECHO: MetadataCore",
  "version": "1.0.0",
  "type": "addon",
  "kind": "library",
  "role": "metadata_core",
  "entrypoint": "com.knoxhack.echo.metadatacore.EchoMetadataCore",
  "publisher": "KnoxHack",
  "channel": "beta",
  "official": true,
  "trustLevel": "official",
  "standalone": true,
  "clientOnly": false,
  "serverOnly": false,
  "side": "common",
  "requires": [
    "echoadaptercore",
    "echocore",
    "echoplatformcore",
    "echoschemacore",
    "echovalidationcore",
    "echopackcore"
