{
  "schema": "echo.mod.v1",
  "id": "echopresencelink",
  "name": "ECHO: Presence Link",
  "version": "1.0.0",
  "type": "addon",
  "kind": "addon",
  "role": "presence_link",
  "entrypoint": "com.knoxhack.echopresencelink.EchoPresenceLink",
  "publisher": "KnoxHack",
  "channel": "beta",
  "official": true,
  "trustLevel": "official",
  "standalone": true,
  "clientOnly": true,
  "serverOnly": false,
  "side": "client",
  "requires": [
    "echoadaptercore",
    "echocore"
  ],
  "optional": [
    "echoashfallprotocol",
    "echocommunitybridge",
    "echoterminal",
    "signalos"
  ],
  "provides": [
    "presence.discord_rpc",
    "presence.privacy",
    "presence.providers",
    "presence.status_commands"
  ],
  "consumes": [
    "echo.core"
  ],
  "gameModes": [
    "all"
  ],
  "permissions": [
    "client.config",
    "discord.ipc",
    "player.activity_read"
  ],
  "assets": [],
  "transforms": [],
