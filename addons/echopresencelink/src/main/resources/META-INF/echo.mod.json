    "adapterCore": {
      "domains": [
        "networking",
        "player",
        "commands",
        "data"
      ],
      "runtimes": [
        "neoforge",
        "echo_native",
        "echo_runtime_standalone"
      ]
    },
    "nativeEntrypoint": "com.knoxhack.echopresencelink.EchoPresenceLinkNativeModule",
    "nativeClasspath": [],
    "notes": "Presence Link is a client-only Discord Rich Presence addon with privacy-first defaults. It does not own Community Bridge bot tokens or server relay behavior."
  },
  "apiStability": "beta",
  "ai": {
    "safeEditZones": [
      "src/main/java/com/knoxhack/echopresencelink/**",
      "src/main/resources/**",
      "docs/**"
    ],
    "protectedFiles": [
      "build.gradle",
      "gradle.properties",
      "README.md"
    ],
    "requiresHumanReview": false,
    "recommendedAgentLanes": [
      "metadata_agent",
      "validation_agent"
    ]
  },
  "deprecatedFeatures": [],
  "replacements": [],
  "conflicts": []
}
