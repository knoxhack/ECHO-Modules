{
  "schema": "echo.platform_roadmap.module_contract.v1",
  "id": "echosettlementcore",
  "name": "ECHO: SettlementCore",
  "phase": 4,
  "role": "settlement_core",
  "status": "runtime-ready",
  "summary": "Bases, shelters, NPC jobs, storage needs, defense score, comfort, and logistics request contracts.",
  "dependencies": {
    "requires": [
      "echocore",
      "echoadaptercore",
      "echobasegrid",
      "echonpcore",
      "echologisticscore",
      "echoworldcore",
      "echohazardcore",
      "echoequipmentcore"
    ],
    "optional": [
      "echofactioncore"
    ]
  },
  "surfaces": {
    "provides": [
      "settlement.registry",
      "settlement.jobs",
      "settlement.defense_score",
      "settlement.logistics_requests"
    ],
    "consumes": [
      "basegrid.claims",
      "npc.profiles",
      "logistics.routing",
      "world.regions",
      "hazard.registry",
      "hazard.resistance"
    ],
    "adapterDomains": [
      "data",
      "entities",
      "worldgen"
    ],
    "nativeEntrypoint": "com.knoxhack.echo.settlementcore.EchoSettlementCoreNativeModule"
  },
  "mvpContracts": [
    "settlement_snapshot",
    "npc_job_contract",
    "defense_score_contract",
    "logistics_request_contract"
  ],
  "probeAssertions": [
    "native entrypoint activates",
    "logical registration count equals descriptor provides count",
    "habitat blocks are registered",
    "settlement service detects safe habitats",
    "resistance provider grants immunity inside safe habitats"
  ],
  "implementationBoundary": "Runtime implementation is present. SettlementService, habitat blocks, block entities, NPC jobs, logistics requests, and hazard resistance integration are active."
}
