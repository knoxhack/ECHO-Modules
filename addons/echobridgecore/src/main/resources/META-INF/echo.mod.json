{
  "schema": "echo.mod.v1",
  "id": "echobridgecore",
  "name": "ECHO: BridgeCore",
  "version": "1.0.0",
  "type": "addon",
  "kind": "library",
  "role": "bridge_core",
  "entrypoint": "com.knoxhack.echo.bridgecore.EchoBridgeCore",
