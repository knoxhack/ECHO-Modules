{
  "schema": "echo.openlands.systems.launcher_execution_acceptance.v1",
  "namespace": "echoopenlandsprotocol",
  "version": "0.1.0",
  "runtimeParity": [
    "echo_native",
    "echo_runtime_standalone",
    "neoforge"
  ],
  "purpose": "Defines the real launcher execution report required before Openlands can clear install, update, repair, rollback, hash verification, and world/config preservation gates. Launcher flow preflight reports only prove mapping; they do not clear Public Alpha.",
  "sourceContracts": {
    "launcherFlow": "systems/launcher_flow_acceptance.json",
    "distribution": "systems/distribution_alpha_gates.json",
    "runtimeAdapterLoadPlan": "systems/runtime_adapter_load_plan.json",
    "runtimeExecutionAcceptance": "systems/runtime_execution_acceptance.json",
    "playtestFixture": "playtests/mvp_first_hour_acceptance.json"
  },
  "reportContract": {
    "schema": "echo.openlands.edition.launcher_execution_report.v1",
    "allowedReportStatus": [
      "passed",
      "failed",
      "blocked"
    ],
    "requiredReportFields": [
      "schema",
      "status",
      "generatedAt",
      "edition",
      "runtimeTarget",
      "moduleId",
      "moduleVersion",
      "moduleArtifact",
      "moduleArtifactSha256",
      "launcherBuild",
      "executionEnvironment",
      "flowResults",
      "clearedLauncherGates",
      "remainingLauncherGates",
      "publicAlphaReady"
    ],
    "requiredFlowFields": [
      "id",
      "status",
      "startedAt",
      "finishedAt",
      "durationMs",
      "runtimeTarget",
      "artifactSha256",
      "inputFixtureRefs",
      "preconditions",
      "plannedActions",
      "actionsRun",
      "assertions",
      "savedArtifacts",
      "worldStatePolicy"
    ],
    "allowedFlowStatus": [
      "passed",
      "failed",
      "blocked",
      "skipped"
    ],
    "requiredAssertionFields": [
      "id",
      "status"
    ],
    "allowedAssertionStatus": [
      "passed",
      "failed",
      "blocked",
      "skipped"
    ],
    "passRules": [
      "Every required launcher flow must be status passed for its edition.",
      "Every assertion in every passed flow must be recorded with status passed.",
      "clearedLauncherGates must include only gates whose owning flow has passed.",
      "publicAlphaReady may be true only when install, update, repair, rollback, artifact hash, and world/config preservation gates are all cleared."
    ]
  },
  "editionReports": [
    {
      "edition": "native",
      "runtimeTarget": "echo_native",
      "repo": "ECHO-Openlands-Native-Edition",
      "requiredReport": "evidence/native-launcher-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0.echo-addon"
    },
    {
      "edition": "neoforge",
      "runtimeTarget": "neoforge",
      "repo": "ECHO-Openlands-NeoForge-Edition",
      "requiredReport": "evidence/neoforge-launcher-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0-neoforge.jar"
    },
    {
      "edition": "standalone",
      "runtimeTarget": "echo_runtime_standalone",
      "repo": "ECHO-Openlands-Standalone-Edition",
      "requiredReport": "evidence/standalone-launcher-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0-standalone.jar"
    }
  ],
  "launcherGates": [
    {
      "id": "real_launcher_fresh_install",
      "flowId": "install",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "launcherChannel",
        "selectedEdition",
        "resolvedManifestId",
        "downloadedArtifactPath",
        "downloadedArtifactSha256",
        "firstWorldId",
        "openlandsRuntimeReadySignal"
      ]
    },
    {
      "id": "real_launcher_artifact_update",
      "flowId": "update",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "previousManifestId",
        "newManifestId",
        "changedArtifactSha256",
        "reusedArtifactSha256",
        "beforeUpdateSaveHash",
        "afterUpdateSaveHash",
        "afterUpdateConfigHash"
      ]
    },
    {
      "id": "real_launcher_repair_corrupt_install",
      "flowId": "repair",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "corruptedArtifactPath",
        "corruptSha256",
        "repairDownloadUrl",
        "restoredSha256",
        "worldDirectoryHashBeforeRepair",
        "worldDirectoryHashAfterRepair",
        "launchAfterRepairResult"
      ]
    },
    {
      "id": "real_launcher_manifest_rollback",
      "flowId": "rollback",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "currentManifestId",
        "previousManifestId",
        "rollbackArtifactSha256",
        "schemaCompatibilityDecision",
        "worldDirectoryHashBeforeRollback",
        "worldDirectoryHashAfterRollback",
        "returnToCurrentManifestResult"
      ]
    },
    {
      "id": "real_launcher_world_config_preservation",
      "flowId": "rollback",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "openlandsStandardConfigHash",
        "userKeybindHash",
        "bedrollSpawnSnapshot",
        "waystoneStateSnapshot",
        "holomapDiscoverySnapshot",
        "rollbackWorldDeletionCount",
        "repairWorldDeletionCount"
      ]
    }
  ],
  "executionSuite": {
    "id": "launcher_distribution_execution",
    "displayName": "Launcher Distribution Execution",
    "requiredFor": [
      "Public Alpha"
    ],
    "minimumRunsPerRuntime": 1,
    "flowIds": [
      "install",
      "update",
      "repair",
      "rollback"
    ]
  },
  "executionFlows": [
    {
      "id": "install",
      "displayName": "Fresh Install",
      "gateIds": [
        "real_launcher_fresh_install"
      ],
      "inputFixtureRefs": [
        "systems/launcher_flow_acceptance.json",
        "systems/distribution_alpha_gates.json",
        "META-INF/echo.mod.json"
      ],
      "preconditions": [
        "selected_edition_present_in_launcher_channel",
        "module_requirement_graph_resolves",
        "artifact_index_metadata_present_before_public_alpha",
        "selected_runtime_available"
      ],
      "plannedActions": [
        "open_echo_launcher_public_alpha_channel",
        "select_openlands_edition_profile",
        "download_release_manifest_from_index",
        "resolve_module_requirement_graph",
        "download_required_module_artifact_to_launcher_cache",
        "verify_artifact_sha256_and_size_against_index",
        "verify_required_descriptors_inside_artifact",
        "create_new_openlands_standard_world",
        "wait_for_openlands_runtime_ready_signal",
        "capture_launcher_install_log_manifest_and_world_id"
      ],
      "assertions": [
        "manifest_download_succeeds",
        "artifact_download_succeeds",
        "sha256_and_size_match_release_index",
        "descriptor_id_version_and_runtime_target_match_edition",
        "openlands_standard_is_selected_by_default",
        "runtime_reports_openlands_runtime_ready",
        "fresh_world_is_created_without_hardcore_meters"
      ],
      "requiredSavedArtifacts": [
        "launcher-install-log.txt",
        "install-manifest.json",
        "artifact-hash.txt",
        "fresh-world-summary.json"
      ],
      "worldStatePolicy": {
        "requiresExistingWorld": false,
        "mustCreateWorld": true,
        "mustPreserveWorlds": false
      }
    },
    {
      "id": "update",
      "displayName": "Artifact Update",
      "gateIds": [
        "real_launcher_artifact_update"
      ],
      "inputFixtureRefs": [
        "systems/launcher_flow_acceptance.json",
        "systems/distribution_alpha_gates.json",
        "playtests/mvp_first_hour_acceptance.json"
      ],
      "preconditions": [
        "previous_manifest_installed",
        "new_manifest_available",
        "changed_artifact_has_new_sha256",
        "unchanged_artifacts_have_same_sha256"
      ],
      "plannedActions": [
        "install_previous_openlands_manifest",
        "create_or_load_first_hour_acceptance_world",
        "capture_pre_update_world_and_config_hashes",
        "switch_launcher_to_new_manifest",
        "download_only_changed_artifacts",
        "reuse_unchanged_artifacts_from_cache",
        "verify_new_artifact_sha256_and_size",
        "launch_updated_openlands_standard_world",
        "compare_required_save_load_fields_after_update",
        "capture_update_log_manifest_and_preservation_report"
      ],
      "assertions": [
        "old_manifest_is_detected",
        "changed_artifact_is_downloaded_once",
        "unchanged_artifacts_are_reused",
        "save_world_directory_is_preserved",
        "openlands_standard_config_is_preserved",
        "waystone_and_holomap_schema_remain_readable",
        "launcher_logs_include_successful_update_marker"
      ],
      "requiredSavedArtifacts": [
        "launcher-update-log.txt",
        "previous-manifest.json",
        "updated-manifest.json",
        "world-preservation-diff.json",
        "config-preservation-diff.json"
      ],
      "worldStatePolicy": {
        "requiresExistingWorld": true,
        "mustCreateWorld": false,
        "mustPreserveWorlds": true
      }
    },
    {
      "id": "repair",
      "displayName": "Repair Corrupt Install",
      "gateIds": [
        "real_launcher_repair_corrupt_install"
      ],
      "inputFixtureRefs": [
        "systems/launcher_flow_acceptance.json",
        "systems/distribution_alpha_gates.json",
        "systems/runtime_adapter_load_plan.json"
      ],
      "preconditions": [
        "installed_manifest_available",
        "one_required_artifact_missing_or_corrupt",
        "release_index_has_repair_metadata"
      ],
      "plannedActions": [
        "install_current_openlands_manifest",
        "create_or_load_first_hour_acceptance_world",
        "capture_pre_repair_world_and_config_hashes",
        "delete_or_corrupt_required_module_artifact",
        "start_launcher_repair_flow",
        "detect_missing_or_corrupt_artifact",
        "redownload_artifact_from_release_index",
        "verify_restored_artifact_sha256_and_size",
        "launch_repaired_openlands_standard_world",
        "compare_world_and_config_hashes_after_repair"
      ],
      "assertions": [
        "missing_or_corrupt_artifact_is_detected",
        "repair_restores_expected_sha256",
        "descriptor_revalidates_after_repair",
        "pack_launches_after_repair",
        "no_world_files_are_deleted",
        "openlands_standard_config_is_preserved",
        "adapter_ready_signal_reports_after_repair"
      ],
      "requiredSavedArtifacts": [
        "launcher-repair-log.txt",
        "corruption-record.json",
        "repair-manifest.json",
        "repair-hash-report.json",
        "repair-preservation-report.json"
      ],
      "worldStatePolicy": {
        "requiresExistingWorld": true,
        "mustCreateWorld": false,
        "mustPreserveWorlds": true
      }
    },
    {
      "id": "rollback",
      "displayName": "Rollback To Previous Manifest",
      "gateIds": [
        "real_launcher_manifest_rollback",
        "real_launcher_world_config_preservation"
      ],
      "inputFixtureRefs": [
        "systems/launcher_flow_acceptance.json",
        "systems/distribution_alpha_gates.json",
        "playtests/mvp_first_hour_acceptance.json",
        "waystones/waystone_contract.json"
      ],
      "preconditions": [
        "previous_manifest_available",
        "previous_artifacts_available",
        "world_schema_compatibility_checked",
        "user_confirmed_schema_warning_when_needed"
      ],
      "plannedActions": [
        "install_current_openlands_manifest",
        "create_or_load_first_hour_acceptance_world",
        "capture_pre_rollback_world_config_waystone_and_holomap_hashes",
        "select_previous_manifest_in_launcher",
        "display_schema_warning_when_world_is_newer_than_target_manifest",
        "download_or_reuse_previous_manifest_artifacts",
        "verify_previous_artifact_sha256_and_size",
        "launch_or_block_world_according_to_schema_decision",
        "verify_worlds_and_configs_are_not_deleted",
        "return_launcher_to_current_manifest_after_test"
      ],
      "assertions": [
        "previous_manifest_is_available",
        "previous_artifacts_are_available",
        "schema_warning_is_visible_when_needed",
        "rollback_does_not_delete_worlds",
        "rollback_does_not_delete_config",
        "bedroll_waystone_and_holomap_snapshots_are_preserved_or_blocked_with_warning",
        "launcher_can_return_to_current_manifest_after_test"
      ],
      "requiredSavedArtifacts": [
        "launcher-rollback-log.txt",
        "rollback-manifest.json",
        "schema-compatibility-decision.json",
        "rollback-preservation-report.json",
        "return-to-current-manifest-report.json"
      ],
      "worldStatePolicy": {
        "requiresExistingWorld": true,
        "mustCreateWorld": false,
        "mustPreserveWorlds": true
      }
    }
  ],
  "publicAlphaClearance": {
    "requiresEveryEditionReport": true,
    "requiresEveryLauncherGateCleared": true,
    "requiresLauncherFlowPreflightReport": true,
    "requiresArtifactUrlsAndSha256": true,
    "preflightReportsDoNotClearLauncherGates": true
  }
}
