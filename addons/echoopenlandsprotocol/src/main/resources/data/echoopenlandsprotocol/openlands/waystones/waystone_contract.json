{
  "schema": "echo.openlands.waystones.v1",
  "namespace": "echoopenlandsprotocol",
  "runtimeParity": [
    "echo_native",
    "echo_runtime_standalone",
    "neoforge"
  ],
  "blocks": [
    "old_road_block",
    "old_road_marker",
    "broken_waystone",
    "restored_waystone",
    "waystone_plinth"
  ],
  "stateMachine": [
    {
      "state": "undiscovered",
      "displayName": "Undiscovered",
      "visibleToHoloMap": false,
      "playerAction": "Approach or observe from line of sight.",
      "next": "discovered"
    },
    {
      "state": "discovered",
      "displayName": "Discovered",
      "visibleToHoloMap": true,
      "playerAction": "Interact with broken_waystone or old_road_marker.",
      "outputs": [
        "region_hint",
        "tutorial:first_waystone_found"
      ],
      "next": "debris_cleared"
    },
    {
      "state": "debris_cleared",
      "displayName": "Debris Cleared",
      "playerAction": "Remove rubble and apply basic stone pieces.",
      "inputs": [
        {
          "item": "echomaterialcore:fieldstone_piece",
          "count": 8,
          "alternates": [
            "block:limestone"
          ]
        }
      ],
      "outputs": [
        "repair_progress:stone"
      ],
      "next": "stone_repaired"
    },
    {
      "state": "stone_repaired",
      "displayName": "Stone Repaired",
      "playerAction": "Use repair kit to stabilize the plinth.",
      "inputs": [
        {
          "item": "repair_kit",
          "count": 1
        }
      ],
      "outputs": [
        "block_variant:broken_waystone/repaired_shell"
      ],
      "next": "fitted"
    },
    {
      "state": "fitted",
      "displayName": "Fitted",
      "playerAction": "Install copper fittings.",
      "inputs": [
        {
          "item": "echoopenlandsprotocol:cupral_fitting",
          "count": 4
        }
      ],
      "outputs": [
        "repair_progress:fittings"
      ],
      "next": "charged"
    },
    {
      "state": "charged",
      "displayName": "Charged",
      "playerAction": "Install a waystone core with a glow crystal charge.",
      "inputs": [
        {
          "item": "waystone_core",
          "count": 1
        },
        {
          "item": "glow_crystal",
          "count": 1
        }
      ],
      "outputs": [
        "map_reveal:local_radius",
        "region_name_prompt"
      ],
      "next": "bound"
    },
    {
      "state": "bound",
      "displayName": "Bound",
      "playerAction": "Apply route binding from map table.",
      "inputs": [
        {
          "item": "route_binding",
          "count": 1
        }
      ],
      "outputs": [
        "route_id",
        "trader_interest"
      ],
      "next": "active"
    },
    {
      "state": "active",
      "displayName": "Active",
      "playerAction": "Use, rename, and optionally link to another active stone.",
      "outputs": [
        "map_reveal:wide_radius",
        "nearby_hints:1-3",
        "trader_visit_eligible",
        "fast_travel_if_two_active"
      ],
      "next": null
    }
  ],
  "effects": {
    "mapRevealRadiusBlocks": {
      "charged": 192,
      "active": 384
    },
    "nearbyHints": {
      "min": 1,
      "max": 3,
      "categories": [
        "cave_mouth",
        "old_mine",
        "ruin",
        "road_segment",
        "resource_patch",
        "settlement_seed"
      ]
    },
    "fastTravel": {
      "enabledByDefault": true,
      "requiresActiveStones": 2,
      "costMode": "free_between_bound_stones",
      "hardlandsCostMode": "route_token_optional"
    }
  },
  "multiplayerState": {
    "ownershipFlags": [
      "owner",
      "group",
      "public"
    ],
    "storedFields": [
      "waystoneId",
      "regionId",
      "customName",
      "state",
      "ownerPlayerId",
      "ownerGroupId",
      "isPublicTravel",
      "canPublicRename",
      "repairContributorIds",
      "linkedRouteIds",
      "lastActivatedAt"
    ],
    "defaultPermissions": {
      "repair": "public",
      "rename": "owner_or_group",
      "travel": "public_after_active",
      "unlink": "owner_or_group"
    }
  }
}
