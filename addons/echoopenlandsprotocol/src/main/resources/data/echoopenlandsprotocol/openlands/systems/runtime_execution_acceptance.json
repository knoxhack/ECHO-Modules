{
  "schema": "echo.openlands.systems.runtime_execution_acceptance.v1",
  "namespace": "echoopenlandsprotocol",
  "version": "0.1.0",
  "runtimeParity": [
    "echo_native",
    "echo_runtime_standalone",
    "neoforge"
  ],
  "purpose": "Defines the real adapter execution reports required to clear Openlands runtime, launcher, artifact upload, and final review gates. Preflight reports are not enough for Public Alpha.",
  "sourceContracts": {
    "productionPhaseMatrix": "progression/production_phase_matrix.json",
    "runtimeAdapterLoadPlan": "systems/runtime_adapter_load_plan.json",
    "playableRuntimeContract": "systems/playable_runtime_contract.json",
    "firstHourPlaytest": "playtests/mvp_first_hour_acceptance.json",
    "waystoneContract": "waystones/waystone_contract.json",
    "homesteadAlpha": "systems/homestead_alpha.json",
    "builderUxAlpha": "systems/builder_ux_alpha.json",
    "creatureRoster": "creatures/mvp_creatures.json",
    "distribution": "systems/distribution_alpha_gates.json",
    "launcherFlow": "systems/launcher_flow_acceptance.json",
    "legalAudit": "systems/legal_content_audit.json"
  },
  "reportContract": {
    "schema": "echo.openlands.edition.runtime_execution_report.v1",
    "allowedReportStatus": [
      "passed",
      "failed",
      "blocked"
    ],
    "requiredReportFields": [
      "schema",
      "status",
      "generatedAt",
      "edition",
      "runtimeTarget",
      "moduleId",
      "moduleVersion",
      "moduleArtifact",
      "moduleArtifactSha256",
      "runtimeBuild",
      "executionEnvironment",
      "scenarioResults",
      "clearedRuntimeGates",
      "remainingRuntimeGates",
      "publicAlphaReady"
    ],
    "requiredScenarioFields": [
      "id",
      "suiteId",
      "status",
      "startedAt",
      "finishedAt",
      "durationMs",
      "runtimeTarget",
      "artifactSha256",
      "inputFixtureRefs",
      "plannedActions",
      "actionsRun",
      "assertions",
      "savedArtifacts"
    ],
    "allowedScenarioStatus": [
      "passed",
      "failed",
      "blocked",
      "skipped"
    ],
    "requiredAssertionFields": [
      "id",
      "status"
    ],
    "allowedAssertionStatus": [
      "passed",
      "failed",
      "blocked",
      "skipped"
    ],
    "passRules": [
      "Every scenario in every required suite must be status passed for its edition.",
      "Every assertion in every passed scenario must be recorded with status passed.",
      "clearedRuntimeGates must include only gates with passing scenario evidence.",
      "publicAlphaReady may be true only when all runtime targets have passed reports and distribution/legal gates are also approved."
    ]
  },
  "editionReports": [
    {
      "edition": "native",
      "runtimeTarget": "echo_native",
      "repo": "ECHO-Openlands-Native-Edition",
      "requiredReport": "evidence/native-runtime-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0.echo-addon"
    },
    {
      "edition": "neoforge",
      "runtimeTarget": "neoforge",
      "repo": "ECHO-Openlands-NeoForge-Edition",
      "requiredReport": "evidence/neoforge-runtime-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0-neoforge.jar"
    },
    {
      "edition": "standalone",
      "runtimeTarget": "echo_runtime_standalone",
      "repo": "ECHO-Openlands-Standalone-Edition",
      "requiredReport": "evidence/standalone-runtime-execution-report.json",
      "artifactPattern": "echoopenlandsprotocol-0.1.0-standalone.jar"
    }
  ],
  "runtimeGates": [
    {
      "id": "real_worldgen_spawn_execution",
      "suiteId": "first_hour_world_runtime",
      "clearsEvidence": [
        "starter_spawn_guarantees_bound",
        "runtime_smoke_test_ready"
      ],
      "mustCapture": [
        "seed",
        "spawnPosition",
        "starterResourceDistances",
        "visibleLandmarkDistance",
        "nearestHostileDistance"
      ]
    },
    {
      "id": "real_adapter_shelter_execution",
      "suiteId": "first_hour_world_runtime",
      "clearsEvidence": [
        "shelter_score_bound"
      ],
      "mustCapture": [
        "placedBlocks",
        "roofCoverage",
        "wallEnclosure",
        "bedrollPosition",
        "lightOrFirePosition",
        "sleepMilestoneAllowed"
      ]
    },
    {
      "id": "real_first_hour_playtest",
      "suiteId": "first_hour_world_runtime",
      "clearsEvidence": [
        "first_hour_runtime_playtest_pass",
        "tutorial_triggers_bound"
      ],
      "mustCapture": [
        "routeStepTimeline",
        "tutorialPromptIds",
        "craftedRecipeIds",
        "visitedLandmarkIds"
