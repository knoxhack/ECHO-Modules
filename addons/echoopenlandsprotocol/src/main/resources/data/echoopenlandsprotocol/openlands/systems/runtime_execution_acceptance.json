        "destinationWaystoneId",
        "permissionDecision",
        "travelResult"
      ]
    },
    {
      "id": "real_homestead_runtime_execution",
      "suiteId": "alpha_runtime",
      "clearsEvidence": [
        "homestead_state_bound"
      ],
      "mustCapture": [
        "cropGrowthSamples",
        "wateringSamples",
        "compostSamples",
        "cookpotMealSamples",
        "animalPenSamples",
        "traderDemandSamples"
      ]
    },
    {
      "id": "real_builder_ux_execution",
      "suiteId": "alpha_runtime",
      "clearsEvidence": [
        "builder_ux_bound",
        "multiplayer_permissions_bound"
      ],
      "mustCapture": [
        "hammerCycleSamples",
        "scaffoldPlacementSamples",
        "quickStackTransaction",
        "quickDepositTransaction",
        "sortTransaction",
        "craftFromStorageTransaction",
