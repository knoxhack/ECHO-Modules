    },
    {
      "id": "launcher_distribution_runtime",
      "displayName": "Launcher And Distribution Runtime",
      "requiredFor": [
        "Public Alpha"
      ],
      "minimumRunsPerRuntime": 1,
      "scenarioIds": [
        "artifact_upload_download_hash",
        "launcher_install_update_repair_rollback"
      ]
    },
    {
      "id": "final_asset_release_review",
      "displayName": "Final Asset And Legal Review",
      "requiredFor": [
        "Public Alpha"
      ],
      "minimumRunsPerRuntime": 1,
      "scenarioIds": [
        "final_owned_asset_review",
        "final_sound_and_branding_review"
      ]
    }
