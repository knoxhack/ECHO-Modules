    {
      "id": "fresh_standard_world_starts",
      "suiteId": "first_hour_world_runtime",
      "gateIds": [
        "real_mvp_runtime_playtest"
      ],
      "inputFixtureRefs": [
        "config/game_modes.json",
        "systems/playable_runtime_contract.json"
      ],
      "actions": [
        "create_new_openlands_standard_world",
        "wait_for_first_interactive_frame",
        "inspect_player_hud",
        "place_and_break_branchwood_planks",
        "exit_to_menu_and_reload"
      ],
      "assertions": [
        "runtime_reports_openlands_runtime_ready",
        "hunger_mode_is_gentle",
        "stamina_hydration_spoilage_temperature_meters_absent",
        "hotbar_and_inventory_are_available",
