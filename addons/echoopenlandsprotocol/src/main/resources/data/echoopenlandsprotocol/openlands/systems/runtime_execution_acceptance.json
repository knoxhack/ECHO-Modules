    {
      "id": "real_launcher_install_update_repair_rollback",
      "suiteId": "launcher_distribution_runtime",
      "clearsEvidence": [
        "launcher_install_update_repair_rollback_pass"
      ],
      "mustCapture": [
        "installRun",
        "updateRun",
        "repairRun",
        "rollbackRun",
        "worldPreservationCheck",
        "configPreservationCheck"
      ]
    },
    {
      "id": "real_mvp_runtime_playtest",
      "suiteId": "first_hour_world_runtime",
      "clearsEvidence": [
        "first_hour_runtime_playtest_pass",
        "runtime_smoke_test_ready",
        "hardcore_meters_default_off"
      ],
      "mustCapture": [
        "freshWorldStart",
        "firstInteractiveFrame",
        "hotbarInventoryState",
        "blockPlaceBreakSample",
        "menuExitReloadSample",
        "hardcoreMeterSnapshot"
      ]
    },
    {
      "id": "final_asset_legal_review",
      "suiteId": "final_asset_release_review",
      "clearsEvidence": [
        "legal_content_audit_pass",
        "missing_asset_policy_applied"
      ],
      "mustCapture": [
        "reviewer",
        "reviewDate",
        "assetManifestHash",
        "legalAuditHash",
        "approvedExceptions",
        "placeholderAssetCount"
      ]
    },
    {
      "id": "final_art_audio_pass",
      "suiteId": "final_asset_release_review",
      "clearsEvidence": [
        "legal_content_audit_pass",
        "sound_events_bound",
        "missing_asset_policy_applied"
      ],
      "mustCapture": [
        "textureReview",
        "modelReview",
        "blockstateReview",
        "iconReview",
        "soundReview",
        "remainingPlaceholderCount"
      ]
    }
  ],
  "executionSuites": [
    {
      "id": "first_hour_world_runtime",
      "displayName": "First-Hour World Runtime",
      "requiredFor": [
        "MVP",
        "Public Alpha"
      ],
      "minimumRunsPerRuntime": 3,
      "scenarioIds": [
        "fresh_standard_world_starts",
        "starter_spawn_seed_sweep",
        "minimal_shelter_sleep",
        "first_hour_route_walkthrough",
        "first_hour_save_reload_roundtrip"
      ]
    },
    {
      "id": "world_creature_runtime",
      "displayName": "Worldgen And Creature Runtime",
      "requiredFor": [
        "Public Alpha"
      ],
      "minimumRunsPerRuntime": 3,
      "scenarioIds": [
        "biome_landmark_seed_sweep",
        "creature_spawn_ai_drop_sound_sweep"
      ]
    },
    {
      "id": "waystone_runtime",
      "displayName": "Waystone And Old Road Runtime",
      "requiredFor": [
        "MVP",
        "Public Alpha"
      ],
      "minimumRunsPerRuntime": 2,
      "scenarioIds": [
        "waystone_repair_state_roundtrip",
        "two_active_waystones_fast_travel",
        "old_road_holomap_route_reveal"
