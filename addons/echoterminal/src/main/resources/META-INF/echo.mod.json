{
  "schema": "echo.mod.v1",
  "id": "echoterminal",
  "name": "ECHO: Terminal",
  "version": "1.0.0",
  "type": "addon",
  "kind": "ui_pack",
  "role": "terminal_surface",
  "entrypoint": "com.knoxhack.echoterminal.EchoTerminal",
  "publisher": "KnoxHack",
  "channel": "beta",
  "official": true,
  "trustLevel": "official",
