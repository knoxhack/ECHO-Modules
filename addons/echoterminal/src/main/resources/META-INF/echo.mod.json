    "echoholomap",
    "echoindex",
    "echolens",
    "echomissioncore",
    "echothemecore",
    "echosignalos"
  ],
  "provides": [
    "terminal.surface"
  ],
  "consumes": [
    "echo.core",
    "echo.net",
    "pack.profile"
