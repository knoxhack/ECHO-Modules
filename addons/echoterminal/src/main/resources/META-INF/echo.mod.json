        "echo_native",
        "echo_runtime_standalone"
      ]
    },
    "requiresConfirmationForWriteActions": true,
    "nativeEntrypoint": "com.knoxhack.echoterminal.EchoTerminalNativeModule",
    "nativeClasspath": []
  },
  "apiStability": "beta",
  "ai": {
    "requiresHumanReview": false,
    "recommendedAgentLanes": [
      "ui_agent",
      "diagnostics_agent"
    ]
  },
  "deprecatedFeatures": [],
  "replacements": [],
  "conflicts": []
