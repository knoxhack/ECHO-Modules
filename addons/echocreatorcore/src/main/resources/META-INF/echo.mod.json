    "nativeEntrypoint": "com.knoxhack.echo.creatorcore.EchoCreatorCoreNativeModule",
    "nativeClasspath": [],
    "requiresConfirmationForWriteActions": true,
    "notes": "In-game creator/admin authoring suite. Draft writes, exports, Codex bridge use, and repo edits are locked behind config and permission gates."
  },
  "apiStability": "experimental",
  "ai": {
    "requiresHumanReview": true,
    "recommendedAgentLanes": [
      "metadata_agent",
      "validation_agent",
      "ui_agent",
      "docs_agent"
    ]
  },
  "deprecatedFeatures": [],
  "replacements": [],
  "conflicts": []
}
