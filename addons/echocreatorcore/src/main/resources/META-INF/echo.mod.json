{
  "schema": "echo.mod.v1",
  "id": "echocreatorcore",
  "name": "ECHO: CreatorCore",
  "version": "1.0.0",
  "type": "addon",
  "kind": "tooling",
  "role": "developer_tool",
  "entrypoint": "com.knoxhack.echo.creatorcore.EchoCreatorCore",
  "publisher": "KnoxHack",
  "channel": "experimental",
  "official": true,
  "trustLevel": "official",
  "standalone": true,
  "clientOnly": false,
  "serverOnly": false,
  "side": "common",
  "requires": [
    "echoadaptercore",
    "echocore"
  ],
  "optional": [
    "echodatacore",
    "echoholomap",
    "echoindex",
    "echolens",
    "echomissioncore",
    "echonpcore",
    "echoscreencore",
    "echoscriptcore",
    "echosoundcore",
    "echoterminal",
    "echotextureforge",
    "echothemecore",
    "echotutorialcore",
    "echoweathercore",
    "echowiki",
    "echoworldcore"
  ],
  "provides": [
    "creator.adapters",
    "creator.codex_studio",
    "creator.dashboard",
    "creator.drafts",
    "creator.validation"
  ],
  "consumes": [
    "echo.core"
  ],
  "gameModes": [
    "dev_tools",
    "creator"
