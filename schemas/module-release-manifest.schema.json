{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/knoxhack/ECHO-Release-Index/main/modules/module-release-manifest.schema.json",
  "title": "ECHO Module Release Manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "generatedAt", "provenance", "contentGraphEvidence", "runtimeConformanceEvidence", "modules"],
  "properties": {
    "schemaVersion": {
      "const": "echo.module.release.v1"
    },
    "releaseId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceRepo": {
      "const": "https://github.com/knoxhack/ECHO-Modules"
    },
    "provenance": {
      "type": "object",
      "required": ["sourceRepo", "generatedBy", "attestation"],
      "properties": {
        "sourceRepo": {
          "const": "https://github.com/knoxhack/ECHO-Modules"
        },
        "commitSha": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "workflowRef": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "runAttempt": {
          "type": "string"
        },
        "refName": {
          "type": "string"
        },
        "eventName": {
          "type": "string"
        },
        "generatedBy": {
          "const": "scripts/generate-module-release.mjs"
        },
        "attestation": {
          "type": "object",
          "required": ["action", "subjectChecksums"],
          "properties": {
            "action": {
              "const": "actions/attest@v4"
            },
            "subjectChecksums": {
              "const": "echo-module-release.tar.gz.sha256"
            }
          }
        }
      }
    },
    "contentGraphEvidence": {
      "type": "object",
      "required": ["kind", "filename", "sha256", "size", "runtimeTarget", "buildMode", "schemaVersion"],
      "properties": {
        "kind": {
          "const": "content-graph-evidence"
        },
        "filename": {
          "const": "content-graph-evidence.json"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "downloadUrl": {
          "type": "string"
        },
        "runtimeTarget": {
          "const": "content-graph"
        },
        "buildMode": {
          "const": "generated"
        },
        "schemaVersion": {
          "const": "echo.content_graph.evidence.v1"
        }
      }
    },
    "runtimeConformanceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "filename", "sha256", "size", "runtimeTarget", "hostId", "buildMode", "schemaVersion", "summary"],
        "properties": {
          "kind": {
            "const": "runtime-conformance"
          },
          "filename": {
            "pattern": "^[a-z0-9_-]+-runtime-conformance\\.json$"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "downloadUrl": {
            "type": "string"
          },
          "runtimeTarget": {
            "enum": ["echo_native", "neoforge", "echo_runtime_standalone", "standalone_engine"]
          },
          "hostId": {
            "enum": ["echo_native", "neoforge", "echo_runtime_standalone", "standalone_engine"]
          },
          "buildMode": {
            "const": "generated"
          },
          "schemaVersion": {
            "const": "echo.runtime.conformance.v1"
          },
          "summary": {
            "type": "object",
            "required": ["status", "supported", "adapted", "fallback", "blocked"],
            "properties": {
              "status": {
                "enum": ["pass", "warning", "fail"]
              },
              "supported": {
                "type": "integer",
                "minimum": 0
              },
              "adapted": {
                "type": "integer",
                "minimum": 0
              },
              "fallback": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduleId", "version", "artifacts"],
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "descriptor": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "const": "META-INF/echo.mod.json"
              },
              "sha256": {
                "type": "string"
              }
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "filename", "sha256", "size", "downloadUrl"],
              "properties": {
                "kind": {
                  "enum": ["echo-addon", "neoforge", "standalone", "sources", "content-graph"]
                },
                "filename": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "downloadUrl": {
                  "type": "string"
                },
                "runtimeTarget": {
                  "enum": ["echo-native", "neoforge", "standalone", "sources", "content-graph"]
                },
                "contains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "buildMode": {
                  "enum": ["compiled-runtime", "source-packaged", "generated", null]
                }
              }
            }
          }
        }
      }
    }
  }
}
